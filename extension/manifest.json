{
  "manifest_version": 3,
  "name": "FinPilot — is it worth it?",
  "version": "0.4.3",
  "description": "Family money copilot: Buy, Think about it or Not worth it on any product page. Built-in ML, no AI keys. Prototype, not financial advice.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open FinPilot"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "contextMenus",
    "activeTab",
    "identity"
  ],
  "host_permissions": [
    "https://api-m.sandbox.paypal.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "detect.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "panel.html"
  }
}
